# Installed to /etc/systemd/system/ by scripts/install-host-config.sh.
[Unit]
Description=C3PO Multi-Agent Coordinator
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/home/exedev/c3po
EnvironmentFile=/home/exedev/c3po/.env
# Refresh images on every (re)start, so each deploy also picks up patch
# releases: pull the pre-built images, rebuild the coordinator on a fresh
# python base. The leading "-" keeps a registry outage from taking C3PO down;
# `up --build` then runs on the cached images.
ExecStartPre=-/usr/bin/docker compose -f docker-compose.prod.yml pull --quiet --ignore-buildable
ExecStartPre=-/usr/bin/docker compose -f docker-compose.prod.yml build --quiet --pull
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up --build --remove-orphans
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml down
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=c3po
User=exedev
Group=exedev

[Install]
WantedBy=multi-user.target
