#!/usr/bin/env python3
"""Background watcher for /c3po auto: block until a message is pending, then exit.

Long-polls GET /agent/api/wait on behalf of an agent and exits as soon as the
agent has unacked messages. Claude Code runs this with Bash
run_in_background, so the session spends zero tokens while idle and wakes
only when the watcher exits.

The cycle is one-shot: wake -> get_messages -> handle -> ack_messages ->
re-arm a new watcher. /agent/api/wait returns any unacked message, so the
agent MUST ack everything it looked at before re-arming, or the new watcher
fires again immediately.

While polling, the agent shows as "watching" in list_agents (the REST wait
registers an active waiter but does not touch the heartbeat).

Usage:
    c3po-watch [--agent-id <machine/project>] [--poll-timeout 240]
    c3po-watch --stop [--agent-id <machine/project>]
    c3po-watch --print-id

Agent ID: --agent-id if given, sanitized the way the hooks sanitize names
("Ansel Family" -> "Ansel-Family"). Otherwise the ID the SessionStart hook saved
for $CLAUDE_CODE_SESSION_ID, else the name that hook would have registered.
--print-id prints the resolved ID and exits 0.

Exit codes:
    0  Messages pending; a short summary is printed to stdout
    1  A watcher is already running for this agent (no-op)
    2  Coordinator rejected the request (401/403/400); C3PO_WATCH_ERROR on stdout
    3  Local setup problem (no credentials / coordinator URL configured)
    other  Crash or killed (SIGTERM from --stop exits 143)

Retried internally (never exits): poll timeout, "retry" status (honours
Retry-After), network errors and 5xx (exponential backoff, max 60s), 429.

Orphan detection: the watcher exits (code 0, C3PO_WATCH_ORPHANED on stdout,
no messages) within OWNER_CHECK_SECONDS once the Claude session that started
it is gone, even mid-poll. Claude Code can kill a session (e.g. the daemon's
idle reaper) and leave the run_in_background shell running, reparented to
pid 1; without this the watcher would keep the agent "watching" with nothing
left to wake. At start it records the process chain from its parent up to the
owning session: $CLAUDE_PID if that is an ancestor, else the nearest ancestor
that looks like Claude Code, else its grandparent. It is orphaned once any link
of that chain breaks (a process in it died, so its child was reparented).
Parent PIDs come from /proc (Linux, BusyBox) or ps (macOS). Exit 0 keeps a
false positive harmless: the session finds no messages and re-arms.

Environment:
    C3PO_WATCH_SLEEP_SCALE  Multiply all sleeps by this factor (tests use 0.01)
"""
from __future__ import annotations

import argparse
import json
import os
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request

PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(PLUGIN_ROOT, "hooks"))

from c3po_common import (  # noqa: E402
    auth_headers,
    get_coordinator_url,
    get_watcher_pid_file,
    read_watcher_pid,
    resolve_own_agent_id,
    sanitize_agent_id,
    stop_watcher,
    urlopen_with_ssl,
)

EXIT_MESSAGES = 0
EXIT_ALREADY_RUNNING = 1
EXIT_REJECTED = 2
EXIT_SETUP = 3

MAX_BACKOFF = 60
OWNER_CHECK_SECONDS = 10
MAX_ANCESTORS = 64
PREVIEW_CHARS = 200
SLEEP_SCALE = float(os.environ.get("C3PO_WATCH_SLEEP_SCALE", "1"))


def log(msg: str) -> None:
    print(f"[c3po-watch] {msg}", file=sys.stderr, flush=True)


def sleep(seconds: float) -> None:
    time.sleep(seconds * SLEEP_SCALE)


class ProcessInfoUnavailable(Exception):
    """Neither /proc nor ps can tell us about other processes."""


def _has_proc() -> bool:
    return os.path.exists("/proc/self/stat")


def parent_pid_of(pid: int) -> int | None:
    """Parent PID of pid, or None if pid no longer exists."""
    if _has_proc():
        try:
            with open(f"/proc/{pid}/stat") as f:
                stat = f.read()
        except OSError:
            return None
        try:
            # "pid (comm) state ppid ..."; comm may contain spaces or parens
            return int(stat.rsplit(")", 1)[1].split()[1])
        except (IndexError, ValueError):
            return None
    try:
        out = subprocess.run(
            ["ps", "-o", "ppid=", "-p", str(pid)],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError) as e:
        raise ProcessInfoUnavailable(str(e)) from e
    try:
        return int(out.stdout.strip()) if out.returncode == 0 else None
    except ValueError:
        return None


def command_of(pid: int) -> list[str]:
    """argv of pid (best effort; [] if unknown)."""
    if _has_proc():
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                return [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
        except OSError:
            return []
    try:
        out = subprocess.run(
            ["ps", "-o", "args=", "-p", str(pid)],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    return out.stdout.split()


def looks_like_claude(argv: list[str]) -> bool:
    """Native binary (argv0 "claude") or node running the npm package."""
    for arg in argv[:2]:
        if os.path.basename(arg) in ("claude", "claude.exe"):
            return True
        if "@anthropic-ai/claude-code" in arg:
            return True
    return False


def ancestors() -> list[int]:
    """PIDs from our parent upward, stopping before pid 1."""
    chain = []
    pid = os.getppid()
    while pid > 1 and len(chain) < MAX_ANCESTORS:
        chain.append(pid)
        pid = parent_pid_of(pid)
        if pid is None:
            break
    return chain


def owner_chain() -> list[int]:
    """Process chain [parent, ..., owning session] to monitor; [] to disable."""
    try:
        chain = ancestors()
    except ProcessInfoUnavailable as e:
        log(f"cannot inspect processes ({e}); watching only the parent")
        return [os.getppid()] if os.getppid() > 1 else []
    if not chain:
        log("parent is already pid 1; orphan detection disabled")
        return []
    try:
        env_pid = int(os.environ.get("CLAUDE_PID", ""))
    except ValueError:
        env_pid = None
    if env_pid in chain:
        return chain[: chain.index(env_pid) + 1]
    for i, pid in enumerate(chain):
        if looks_like_claude(command_of(pid)):
            return chain[: i + 1]
    return chain[:2]


def owner_gone(chain: list[int]) -> bool:
    """True once any parent link recorded in chain no longer holds."""
    if not chain:
        return False
    if os.getppid() != chain[0]:
        return True
    try:
        for child, parent in zip(chain, chain[1:]):
            if parent_pid_of(child) != parent:
                return True
    except ProcessInfoUnavailable:
        return False
    return False


def start_owner_monitor(agent_id: str, chain: list[int]) -> None:
    """Exit the whole process once the owning session is gone, even mid-poll."""
    if not chain:
        return
    log(f"watching session pid {chain[-1]} (chain {chain})")

    def run() -> None:
        while True:
            sleep(OWNER_CHECK_SECONDS)
            if owner_gone(chain):
                log(f"session pid {chain[-1]} is gone; exiting")
                release_pid_file(agent_id)
                print(f"C3PO_WATCH_ORPHANED session pid {chain[-1]} is gone; no messages", flush=True)
                # os._exit: the main thread may be blocked in a long poll.
                # Closing the socket ends the server-side wait too.
                os._exit(EXIT_MESSAGES)

    threading.Thread(target=run, name="owner-monitor", daemon=True).start()


def claim_pid_file(agent_id: str) -> bool:
    """Write our PID to the agent's pidfile. False if another watcher is live."""
    if read_watcher_pid(agent_id) is not None:
        return False
    path = get_watcher_pid_file(agent_id)
    fd = os.open(path, os.O_CREAT | os.O_WRONLY | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(str(os.getpid()))
    return True


def release_pid_file(agent_id: str) -> None:
    """Remove the pidfile, but only if it is still ours."""
    path = get_watcher_pid_file(agent_id)
    try:
        with open(path) as f:
            if f.read().strip() != str(os.getpid()):
                return
        os.unlink(path)
    except (OSError, ValueError):
        pass


def summarize(agent_id: str, messages: list[dict]) -> str:
    lines = [f"C3PO_MESSAGES {len(messages)} pending for {agent_id}"]
    for msg in messages:
        msg_id = msg.get("reply_id") or msg.get("id", "?")
        parts = [f"- id={msg_id}", f"from={msg.get('from_agent', '?')}"]
        if msg.get("reply_to"):
            parts.append(f"reply_to={msg['reply_to']}")
        text = msg.get("message") or ""
        preview = " ".join(str(text).split())[:PREVIEW_CHARS]
        parts.append(f"preview={json.dumps(preview)}")
        lines.append(" ".join(parts))
    lines.append("Next: get_messages -> handle -> reply -> ack_messages -> re-arm c3po-watch")
    return "\n".join(lines)


def watch(agent_id: str, poll_timeout: int) -> int:
    headers = auth_headers()
    if not headers and not os.environ.get("C3PO_COORDINATOR_URL"):
        print(
            "C3PO_WATCH_SETUP no credentials found (~/.claude/c3po-credentials.json); "
            "run /c3po setup or fall back to loop mode"
        )
        return EXIT_SETUP

    url = f"{get_coordinator_url()}/agent/api/wait?timeout={poll_timeout}"
    headers["X-Machine-Name"] = agent_id
    start_owner_monitor(agent_id, owner_chain())
    backoff = 1

    while True:
        try:
            req = urllib.request.Request(url, headers=headers)
            with urlopen_with_ssl(req, timeout=poll_timeout + 30) as resp:
                data = json.loads(resp.read())
                retry_after = resp.headers.get("Retry-After")
        except urllib.error.HTTPError as e:
            if e.code in (400, 401, 403):
                body = e.read().decode(errors="replace")[:500]
                print(f"C3PO_WATCH_ERROR HTTP {e.code}: {body}")
                return EXIT_REJECTED
            wait = MAX_BACKOFF if e.code == 429 else backoff
            log(f"HTTP {e.code}; retrying in {wait}s")
            sleep(wait)
            backoff = min(backoff * 2, MAX_BACKOFF)
            continue
        except (urllib.error.URLError, OSError, ValueError) as e:
            log(f"request failed ({e}); retrying in {backoff}s")
            sleep(backoff)
            backoff = min(backoff * 2, MAX_BACKOFF)
            continue

        backoff = 1
        status = data.get("status")
        if status == "received" and data.get("messages"):
            print(summarize(agent_id, data["messages"]))
            return EXIT_MESSAGES
        if status == "retry":
            wait = int(retry_after or 15)
            log(f"coordinator restarting; retrying in {wait}s")
            sleep(wait)
        # "timeout" (or an empty "received"): poll again


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--agent-id", help="Full agent ID (machine/project); default: this session's")
    # Under the 300s idle cutoff of the exe.dev edge in front of prod; a longer
    # poll gets an edge 503 instead of a timeout (coordinator caps it at 240 too).
    parser.add_argument("--poll-timeout", type=int, default=240,
                        help="Server-side wait per request, seconds (1-3600, default 240)")
    parser.add_argument("--stop", action="store_true", help="Stop the running watcher for this agent")
    parser.add_argument("--print-id", action="store_true", help="Print the resolved agent ID and exit")
    args = parser.parse_args()

    if args.agent_id:
        args.agent_id = sanitize_agent_id(args.agent_id)
    else:
        args.agent_id, source = resolve_own_agent_id()
        log(f"agent ID {args.agent_id} ({source})")

    if args.print_id:
        print(args.agent_id)
        return 0

    if "/" not in args.agent_id:
        print(f"C3PO_WATCH_SETUP agent ID must be machine/project, got {args.agent_id!r}")
        return EXIT_SETUP

    if args.stop:
        pid = stop_watcher(args.agent_id)
        print(f"Stopped watcher pid {pid}" if pid else "No watcher running")
        return 0

    if not claim_pid_file(args.agent_id):
        print(f"C3PO_WATCH_RUNNING watcher already running (pid {read_watcher_pid(args.agent_id)})")
        return EXIT_ALREADY_RUNNING

    signal.signal(signal.SIGTERM, lambda *_: sys.exit(128 + signal.SIGTERM))
    try:
        return watch(args.agent_id, max(1, min(3600, args.poll_timeout)))
    finally:
        release_pid_file(args.agent_id)


if __name__ == "__main__":
    sys.exit(main())
