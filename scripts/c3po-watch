#!/usr/bin/env python3
"""Background watcher for /c3po auto: block until a message is pending, then exit.

Long-polls GET /agent/api/wait on behalf of an agent and exits as soon as the
agent has unacked messages. Claude Code runs this with Bash
run_in_background, so the session spends zero tokens while idle and wakes
only when the watcher exits.

The cycle is one-shot: wake -> get_messages -> handle -> ack_messages ->
re-arm a new watcher. /agent/api/wait returns any unacked message, so the
agent MUST ack everything it looked at before re-arming, or the new watcher
fires again immediately.

While polling, the agent shows as "watching" in list_agents (the REST wait
registers an active waiter but does not touch the heartbeat).

Usage:
    c3po-watch --agent-id <machine/project> [--poll-timeout 600]
    c3po-watch --stop --agent-id <machine/project>

Exit codes:
    0  Messages pending; a short summary is printed to stdout
    1  A watcher is already running for this agent (no-op)
    2  Coordinator rejected the request (401/403/400); C3PO_WATCH_ERROR on stdout
    3  Local setup problem (no credentials / coordinator URL configured)
    other  Crash or killed (SIGTERM from --stop exits 143)

Retried internally (never exits): poll timeout, "retry" status (honours
Retry-After), network errors and 5xx (exponential backoff, max 60s), 429.

The watcher also exits quietly (code 0, no messages) if its parent process
goes away, so an orphaned watcher can't keep the agent "watching" forever.

Environment:
    C3PO_WATCH_SLEEP_SCALE  Multiply all sleeps by this factor (tests use 0.01)
"""
from __future__ import annotations

import argparse
import json
import os
import signal
import sys
import time
import urllib.error
import urllib.request

PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(PLUGIN_ROOT, "hooks"))

from c3po_common import (  # noqa: E402
    auth_headers,
    get_coordinator_url,
    get_watcher_pid_file,
    read_watcher_pid,
    stop_watcher,
    urlopen_with_ssl,
)

EXIT_MESSAGES = 0
EXIT_ALREADY_RUNNING = 1
EXIT_REJECTED = 2
EXIT_SETUP = 3

MAX_BACKOFF = 60
PREVIEW_CHARS = 200
SLEEP_SCALE = float(os.environ.get("C3PO_WATCH_SLEEP_SCALE", "1"))


def log(msg: str) -> None:
    print(f"[c3po-watch] {msg}", file=sys.stderr, flush=True)


def sleep(seconds: float) -> None:
    time.sleep(seconds * SLEEP_SCALE)


def claim_pid_file(agent_id: str) -> bool:
    """Write our PID to the agent's pidfile. False if another watcher is live."""
    if read_watcher_pid(agent_id) is not None:
        return False
    path = get_watcher_pid_file(agent_id)
    fd = os.open(path, os.O_CREAT | os.O_WRONLY | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(str(os.getpid()))
    return True


def release_pid_file(agent_id: str) -> None:
    """Remove the pidfile, but only if it is still ours."""
    path = get_watcher_pid_file(agent_id)
    try:
        with open(path) as f:
            if f.read().strip() != str(os.getpid()):
                return
        os.unlink(path)
    except (OSError, ValueError):
        pass


def summarize(agent_id: str, messages: list[dict]) -> str:
    lines = [f"C3PO_MESSAGES {len(messages)} pending for {agent_id}"]
    for msg in messages:
        msg_id = msg.get("reply_id") or msg.get("id", "?")
        parts = [f"- id={msg_id}", f"from={msg.get('from_agent', '?')}"]
        if msg.get("reply_to"):
            parts.append(f"reply_to={msg['reply_to']}")
        text = msg.get("message") or ""
        preview = " ".join(str(text).split())[:PREVIEW_CHARS]
        parts.append(f"preview={json.dumps(preview)}")
        lines.append(" ".join(parts))
    lines.append("Next: get_messages -> handle -> reply -> ack_messages -> re-arm c3po-watch")
    return "\n".join(lines)


def watch(agent_id: str, poll_timeout: int) -> int:
    headers = auth_headers()
    if not headers and not os.environ.get("C3PO_COORDINATOR_URL"):
        print(
            "C3PO_WATCH_SETUP no credentials found (~/.claude/c3po-credentials.json); "
            "run /c3po setup or fall back to loop mode"
        )
        return EXIT_SETUP

    url = f"{get_coordinator_url()}/agent/api/wait?timeout={poll_timeout}"
    headers["X-Machine-Name"] = agent_id
    parent_pid = os.getppid()
    backoff = 1

    while True:
        if os.getppid() != parent_pid:
            log("parent process exited; stopping")
            return EXIT_MESSAGES

        try:
            req = urllib.request.Request(url, headers=headers)
            with urlopen_with_ssl(req, timeout=poll_timeout + 30) as resp:
                data = json.loads(resp.read())
                retry_after = resp.headers.get("Retry-After")
        except urllib.error.HTTPError as e:
            if e.code in (400, 401, 403):
                body = e.read().decode(errors="replace")[:500]
                print(f"C3PO_WATCH_ERROR HTTP {e.code}: {body}")
                return EXIT_REJECTED
            wait = MAX_BACKOFF if e.code == 429 else backoff
            log(f"HTTP {e.code}; retrying in {wait}s")
            sleep(wait)
            backoff = min(backoff * 2, MAX_BACKOFF)
            continue
        except (urllib.error.URLError, OSError, ValueError) as e:
            log(f"request failed ({e}); retrying in {backoff}s")
            sleep(backoff)
            backoff = min(backoff * 2, MAX_BACKOFF)
            continue

        backoff = 1
        status = data.get("status")
        if status == "received" and data.get("messages"):
            print(summarize(agent_id, data["messages"]))
            return EXIT_MESSAGES
        if status == "retry":
            wait = int(retry_after or 15)
            log(f"coordinator restarting; retrying in {wait}s")
            sleep(wait)
        # "timeout" (or an empty "received"): poll again


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--agent-id", required=True, help="Full agent ID (machine/project)")
    parser.add_argument("--poll-timeout", type=int, default=600,
                        help="Server-side wait per request, seconds (1-3600, default 600)")
    parser.add_argument("--stop", action="store_true", help="Stop the running watcher for this agent")
    args = parser.parse_args()

    if "/" not in args.agent_id:
        print(f"C3PO_WATCH_SETUP agent ID must be machine/project, got {args.agent_id!r}")
        return EXIT_SETUP

    if args.stop:
        pid = stop_watcher(args.agent_id)
        print(f"Stopped watcher pid {pid}" if pid else "No watcher running")
        return 0

    if not claim_pid_file(args.agent_id):
        print(f"C3PO_WATCH_RUNNING watcher already running (pid {read_watcher_pid(args.agent_id)})")
        return EXIT_ALREADY_RUNNING

    signal.signal(signal.SIGTERM, lambda *_: sys.exit(128 + signal.SIGTERM))
    try:
        return watch(args.agent_id, max(1, min(3600, args.poll_timeout)))
    finally:
        release_pid_file(args.agent_id)


if __name__ == "__main__":
    sys.exit(main())
